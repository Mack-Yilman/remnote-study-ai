{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mack-Yilman/remnote-study-ai/schemas/errores.schema.json",
  "title": "Errores de estudio → tarjetas de RemNote (contrato v1)",
  "type": "object",
  "required": ["version", "origen", "errores"],
  "properties": {
    "version": { "const": 1 },
    "origen": { "type": "string", "minLength": 1, "description": "Quién envía los errores: okt, tesis-salud, gym-coach, manual…" },
    "errores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tema", "pregunta", "respuesta"],
        "properties": {
          "tema": { "type": "string", "minLength": 1, "description": "Va al documento «Errores – <tema>»." },
          "pregunta": { "type": "string", "minLength": 1 },
          "respuesta": { "type": "string", "minLength": 1, "description": "La respuesta correcta, no la que dio el estudiante." },
          "tipo": { "enum": ["basica", "concepto", "bidireccional"], "default": "basica" },
          "fuente": { "type": "string", "description": "Opcional: de dónde salió (simulacro, nota, página)." },
          "fecha": { "type": "string", "description": "Opcional: AAAA-MM-DD del error." }
        }
      }
    }
  }
}
